# ============================================================
# Secure Manuscript Intelligence Platform — configuration
# Copier ce fichier vers `.env` et renseigner les valeurs.
# NE JAMAIS committer le fichier `.env` (voir .gitignore).
# ============================================================

# ---- Application ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# ---- Gemini (VLM) ----
# La clé ne doit JAMAIS être exposée au frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- PostgreSQL ----
POSTGRES_USER=manuscript
POSTGRES_PASSWORD=change_me
POSTGRES_DB=manuscript_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://manuscript:change_me@localhost:5432/manuscript_ai

# ---- MinIO (stockage objet) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_DOCUMENTS=documents

# ---- Authentication (JWT) ----
# Générer avec: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Seuils de confiance (Human-in-the-loop) ----
# Valeurs par défaut provisoires — à calibrer sur le dataset d'évaluation.
OCR_CONFIDENCE_THRESHOLD=0.75
ANALYSIS_CONFIDENCE_THRESHOLD=0.70

# ---- Upload ----
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf